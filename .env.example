# Server-side only. Inject secrets at runtime; never use VITE_ prefixes.
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
# Optional: override the existing CodeFormer restoration model version.
REPLICATE_MODEL_VERSION=
PORT=3000
# Public client configuration (NOT a service_role or secret key).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Private beta allowlist, separated by semicolons. Empty list blocks all AI access.
AUTH_ALLOWED_EMAILS=
